# ─────────────────────────────────────────────────────────────────────────────
# Firebase Configuration
# 1. Go to https://console.firebase.google.com
# 2. Create project "uha-league"
# 3. Add Web app → copy config values below
# 4. Enable Firestore Database (in production mode)
# 5. Enable Authentication (Email/Password)
# 6. Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Cloudflare R2 (хранилище фото)
R2_ACCOUNT_ID=4bef62360b781e6d92501c4150f31908
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uhashop
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-b73784279cbc4741bff58fd981a46a9c.r2.dev

# Firebase Admin (нужен для скрипта переноса и API-роутов) — взять в Vercel
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
